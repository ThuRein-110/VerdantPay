{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin": {
      "root": "admin",
      "framework": "nextjs",
      "installCommand": "cd .. && pnpm install --frozen-lockfile",
      "buildCommand": "cd .. && pnpm exec turbo build --filter=@mfu/admin",
      "outputDirectory": ".next"
    },
    "users": {
      "root": "users",
      "framework": "nextjs",
      "installCommand": "cd .. && pnpm install --frozen-lockfile",
      "buildCommand": "cd .. && pnpm exec turbo build --filter=@mfu/users",
      "outputDirectory": ".next"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "finance-verdantpay.vercel.app" }],
      "destination": { "service": "admin" }
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": { "pre": "finance." } }],
      "destination": { "service": "admin" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "users" }
    }
  ],
  "crons": [
    { "path": "/api/security-retention", "schedule": "0 3 * * *" }
  ]
}
